HALO_BASE_URL=https://yourtenant.halopsa.com
HALO_CLIENT_ID=your-client-id
HALO_CLIENT_SECRET=your-client-secret
HALO_SCOPE=all

# Registered writes and live validation remain disabled by default.
CHATPSA_ENABLE_WRITES=false
CHATPSA_TRANSPORT=stdio
HALO_TIMEOUT_SECONDS=30

# AI assistance. Keep real values only in .env on the Debian host.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_IMAGE_DETAIL=low
OPENAI_MAX_OUTPUT_TOKENS=4000

# Domotz Public API (read-only usage by ChatPSA).
DOMOTZ_API_URL=https://api-eu-west-1-cell-1.domotz.com/public-api/v1/
DOMOTZ_API_KEY=your-domotz-api-key

# Web server. Keep 127.0.0.1 when an authenticated reverse proxy is used.
CHATPSA_WEB_HOST=127.0.0.1
CHATPSA_WEB_PORT=8765
CHATPSA_ALLOWED_HOSTS=localhost,127.0.0.1
CHATPSA_ALLOWED_ORIGINS=http://localhost:8765
CHATPSA_TENANT_NAME=Example tenant

# Temporary single-token access (local setup only).
CHATPSA_AUTH_MODE=token
CHATPSA_ACCESS_TOKEN=replace-with-a-long-random-value
CHATPSA_AGENT_ACCESS_TOKEN=replace-with-a-different-long-random-value
# Optional personal agent tokens. Keys must be lowercase email addresses.
# Keep this JSON on one line. The shared token above always uses a non-personal
# shared history and cannot claim an arbitrary email address.
CHATPSA_AGENT_IDENTITIES_JSON={"agent@example.com":{"name":"Example Agent","token":"replace-with-a-unique-agent-token"}}
CHATPSA_DEFAULT_AGENT_NAME=Local administrator
CHATPSA_DEFAULT_AGENT_EMAIL=administrator@example.com

# Production agent login: put ChatPSA behind an OIDC reverse proxy. The proxy
# must inject verified X-Forwarded-Email, X-Forwarded-User and this shared secret.
# CHATPSA_AUTH_MODE=proxy
# CHATPSA_PROXY_SHARED_SECRET=replace-with-another-long-random-value

# Approvers must be identified by their verified login email.
CHATPSA_APPROVER_EMAILS=luca@example.com,francesco@example.com
CHATPSA_APPROVAL_DB=/app/data/approvals.sqlite3
CHATPSA_PUBLIC_URL=https://chatpsa.example.internal
# Explicitly allow only reviewed action executors. Empty keeps approval execution off.
CHATPSA_APPROVAL_EXECUTION_ACTIONS=

# Optional approval notification email.
CHATPSA_SMTP_HOST=smtp.example.com
CHATPSA_SMTP_PORT=587
CHATPSA_SMTP_USERNAME=chatpsa@example.com
CHATPSA_SMTP_PASSWORD=your-smtp-password
CHATPSA_SMTP_FROM=chatpsa@example.com
